# ============================================================================
# MealMate AI 环境变量示例
# 复制为 .env.local 后填入真实值（.env.local 已在 .gitignore 中，不会被提交）
#
# ⚠️ 安全红线：
# 1. MCD_MCP_TOKEN 只能存在于服务端，**绝对不要**改成 NEXT_PUBLIC_MCD_MCP_TOKEN，
#    否则它会被打进浏览器 bundle。
# 2. 不要把真实 token 写进 README、测试、截图或 issue。
# ============================================================================

# 麦当劳 MCP 端点（Streamable HTTP）
MCD_MCP_URL=https://mcp.mcd.cn

# 麦当劳 MCP 鉴权 Token（服务端专用，留空则 MCP 相关接口返回 503）
MCD_MCP_TOKEN=

# 单次 MCP 调用超时（毫秒）
MCD_MCP_TIMEOUT_MS=20000

# 默认门店编码（可选，用于后续「单餐决策」默认门店）
MCD_DEFAULT_STORE_CODE=1400359

# 套餐数据源：目前仅支持 mcd-mcp
MEAL_PROVIDER=mcd-mcp

# ============================================================================
# AI 大模型（任务 004）
# ----------------------------------------------------------------------------
# 不配置 AI_API_KEY 时，系统自动进入「规则解析」模式（只识别预算/餐次/口味/排除等
# 有限条件），并在接口返回与页面上明确标注，不会冒充大模型的语义理解能力。
#
# ⚠️ 同样是服务端专用：不要加 NEXT_PUBLIC_ 前缀，否则会被打进浏览器 bundle。
# ============================================================================

# 模型 API Key（留空 = 规则降级模式）
AI_API_KEY=

# OpenAI 兼容端点前缀（会拼成 {AI_BASE_URL}/chat/completions）
# 也可以直接写到完整端点，例如 https://api.example.com/v1/chat/completions
AI_BASE_URL=https://api.openai.com/v1

# 模型名（跟随所选供应商）
AI_MODEL=gpt-4o-mini

# 单次模型调用超时（毫秒，1000~60000），超时自动降级为规则解析
AI_TIMEOUT_MS=12000

# 是否发送 response_format={"type":"json_object"}（默认 0）
# 只有确认你的供应商支持结构化输出时才设为 1；本系统不依赖它。
AI_JSON_MODE=0
